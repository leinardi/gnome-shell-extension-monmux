# OS files
.DS_Store
Thumbs.db
desktop.ini

# IntelliJ: only the shared code style and copyright profile are tracked
.idea/*
!.idea/codeStyles/
!.idea/copyright/
*.iml

# Other editors
.vscode/
*.code-workspace
*.swp
*~

# --- Extension build outputs ---
# `make ext-pack` writes the shell-extension zip here.
/dist/
# `make ext-schemas` compiles the schema next to its source.
/src/schemas/gschemas.compiled

# --- Node ---
node_modules/

# Tool caches
.cache/

# Claude Code: the shared settings and the skills symlink are tracked; local settings
# (settings.local.json) and session state never are.
.claude/*
!.claude/settings.json
!.claude/skills
